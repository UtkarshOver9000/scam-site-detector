{
  "name": "scam-site-detector",
  "version": "1.0.0",
  "description": "Real-time browser extension that scores the current page for phishing/scam signals.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "benchmark": "tsx src/detection/runBenchmark.ts",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.279",
    "@types/jsdom": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.11",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
